# Copy to .env for local development. NEVER commit real values.
# Production and staging values live only in Netlify environment settings,
# with separate test (staging) and live (production) credentials.
# Each variable lists the PR that starts using it.

# --- Site ---------------------------------------------------------------
# Public base URL, no trailing slash. Used for payment return URLs and links in emails. (PR 3)
SITE_URL=

# --- Supabase (PR 1) ------------------------------------------------------
SUPABASE_URL=
# Public anon key: safe for the browser, read-only via RLS. Used by the build
# (catalogue + admin config) and by admin functions as the API key (PR 8).
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments: Payfast, ZAR (PR 3; decision D1/D2, ADR-0009) -------------
# sandbox | live. Selects sandbox.payfast.co.za vs www.payfast.co.za and the
# API ?testing=true flag. Staging is always sandbox; only production is live.
PAYFAST_MODE=
PAYFAST_MERCHANT_ID=
# Not secret on its own (it appears in the checkout form), but kept per environment.
PAYFAST_MERCHANT_KEY=
# SERVER ONLY. Salts every checkout/ITN/API signature. Set in the Payfast
# dashboard (Settings) and here; never in the browser or the repo.
PAYFAST_PASSPHRASE=

# --- Email (PR 6; docs/email.md) -------------------------------------------
# SERVER ONLY. A Resend key with "Sending access" for the verified domain.
RESEND_API_KEY=
# "Carmen <orders@clientdomain>" (D19); the domain must be verified in Resend.
EMAIL_FROM=
# Where buyers' replies go (the client's support inbox). Optional.
EMAIL_REPLY_TO=
# Who is told when a buyer email fails permanently. Optional but recommended.
ALERT_EMAIL_TO=
# Shown on receipts only if VAT-registered (D3). Optional.
VAT_NUMBER=

# Download links: 7 days and 5 downloads (D5) are set in the database
# (download_policy()), not here.

# --- Admin publishing (PR 9) -----------------------------------------------
NETLIFY_BUILD_HOOK_URL=
