# Copy to .env for local development. NEVER commit real values.
# Production and staging values live only in Netlify environment settings,
# with separate test (staging) and live (production) credentials.
# Each variable lists the PR that starts using it.

# --- Site ---------------------------------------------------------------
# Public base URL, no trailing slash. Used for payment return URLs and links in emails. (PR 3)
SITE_URL=

# --- Supabase (PR 1) ------------------------------------------------------
SUPABASE_URL=
# Public anon key: safe for the browser, read-only via RLS.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (PR 3; provider chosen by decision D1) ---------------------
# One of: paystack | stripe
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (PR 6) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Where operational alerts go (PR 11).
ALERT_EMAIL_TO=

# --- Delivery (PR 5; defaults per decision D5) ----------------------------
DOWNLOAD_LINK_TTL_DAYS=7
DOWNLOAD_MAX_COUNT=5

# --- Admin publishing (PR 9) -----------------------------------------------
NETLIFY_BUILD_HOOK_URL=
